# Copy to .env (git-ignored) and fill in on the MacBook only.
# The Windows PC never holds provider keys (plan_a.md 5.2.4).

# Select the machine-specific profile.
UTRACK_MACHINE=macbook

# OpenAI-compatible LiteLLM proxy used for the U1 forecaster adapter.
# Keep these values local; never commit real credentials.
LITELLM_PROXY_URL=
LITELLM_API_KEY=

# Only needed if the Dr-CiK dataset on Hugging Face becomes gated; it is public as of U0.1.
HF_TOKEN=
